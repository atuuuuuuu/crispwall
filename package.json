{
  "name": "crispwall",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Make any picture a sharp wallpaper for your exact screen. AI upscaling that runs on your device; nothing is uploaded.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --dir src",
    "e2e": "playwright test",
    "lint": "biome check .",
    "check": "npm run lint && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "onnxruntime-web": "^1.31.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
